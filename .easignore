# Mirrors .gitignore (EAS uses .easignore INSTEAD of .gitignore when present).
# Kept in sync so ignored paths + local release artifacts never enter the build.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# local release artifacts (large; not needed for EAS builds)
release/
